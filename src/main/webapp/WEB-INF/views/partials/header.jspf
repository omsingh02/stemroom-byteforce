<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> | Stemroom</title>
    <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<body>
<header class="topbar">
    <a class="brand" href="${ctx}/dashboard">Stemroom</a>
    <c:if test="${not empty currentUser}">
        <nav>
            <a href="${ctx}/dashboard">Home</a>
            <c:choose>
                <c:when test="${currentUser.canModerate()}">
                    <a href="${ctx}/admin/users">Users</a>
                    <a href="${ctx}/admin/moderation">Moderation</a>
                    <a href="${ctx}/admin/settings">Settings</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/projects">Projects</a>
                    <a href="${ctx}/portfolio">Portfolio</a>
                </c:otherwise>
            </c:choose>
        </nav>
        <div class="who">
            <c:out value="${currentUser.name}"/> (<c:out value="${currentUser.roleLabel}"/>)
            <a href="${ctx}/logout">Log out</a>
        </div>
    </c:if>
</header>
<main>
